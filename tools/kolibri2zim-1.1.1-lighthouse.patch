+def is_gone(exc) -> bool:
+    # local patch (Lighthouse): HTTP 404/410 is permanent, so skip instead of retry/fail
+    resp = getattr(exc, "response", None)
+    return isinstance(exc, requests.exceptions.HTTPError) and getattr(
+        resp, "status_code", None
+    ) in (404, 410)
+
+
+def _retryable(exc) -> bool:
+    return not is_gone(exc)
+
