+def stream_file(url, fpath=None, byte_stream=None, *args, **kwargs):
+    # local patch (Lighthouse): retry stalled or dropped downloads from scratch
+    import time
+
+    for attempt in range(6):
+        try:
+            return _stream_file_once(url, fpath, byte_stream, *args, **kwargs)
+        except (
+            requests.exceptions.ConnectionError,
+            requests.exceptions.Timeout,
+            requests.exceptions.ChunkedEncodingError,
+        ) as exc:
+            if attempt == 5:
+                raise
+            logger.warning(f"PATCH retry {attempt + 1}/5 for {url}: {exc}")
+            if byte_stream is not None:
+                byte_stream.seek(0)
+                byte_stream.truncate()
+            time.sleep(10 * (attempt + 1))
