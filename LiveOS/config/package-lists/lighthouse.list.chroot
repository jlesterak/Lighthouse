# XFCE Base Environment
task-xfce-desktop
lightdm

# The build sets --apt-recommends false, so anything only *recommended* by the
# packages above has to be listed explicitly.
# live-config: user-setup creates the live user (no user = no autologin)
user-setup
locales
console-setup

# Desktop basics XFCE only recommends
xfce4-terminal
mousepad
ristretto
xfce4-notifyd
xdg-user-dirs
dbus-x11
gvfs
udisks2
thunar-volman

# Wi-Fi and GPU firmware, so the stick works on whatever PC is at hand
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-amd-graphics

# Filesystems
exfat-fuse
exfatprogs
dosfstools
squashfs-tools

# Networking & Web
network-manager-gnome
# NetworkManager only *recommends* these, and the build skips recommends: without
# wpasupplicant every Wi-Fi card shows "unavailable"/"not ready" (found on real hardware,
# Intel AX201, 2026-10-01). wireless-regdb sets legal channels; iw/rfkill to diagnose.
wpasupplicant
wireless-regdb
iw
rfkill
firefox-esr
curl
wget
aria2

# System Tools
sudo
nano
htop
gparted
fdisk

# Python for the Updater
python3
python3-full
jq

# Offline ZIM readers: kiwix is kiwix-desktop; kiwix-tools adds kiwix-serve
# so phones on the same network can browse the library in a web browser
kiwix
kiwix-tools

# Lighthouse Custom Dependencies
xdg-utils
libfuse2
marble
