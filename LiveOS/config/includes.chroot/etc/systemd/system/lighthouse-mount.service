[Unit]
Description=Lighthouse Data Partition Auto-Mount
# live-config creates the live user; wait for it so the Desktop shortcut has a home
After=local-fs.target systemd-udevd.service live-config.service
Before=display-manager.service
ConditionPathExists=/usr/local/bin/lighthouse-mount.sh

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lighthouse-mount.sh
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
