# Downloaded data
content/
readers/
root.xml

# Python
__pycache__/
*.pyc

# live-build output and state (regenerated by `lb config` / `lb build`)
LiveOS/.build/
LiveOS/cache/
LiveOS/chroot/
LiveOS/binary/
LiveOS/chroot.files
LiveOS/chroot.packages.*
LiveOS/*.iso
LiveOS/*.contents
LiveOS/*.files
LiveOS/*.packages
LiveOS/*.log
LiveOS/config/binary
LiveOS/config/bootstrap
LiveOS/config/chroot
LiveOS/config/common
LiveOS/config/source
# Stock hooks are symlinks that `lb config` recreates; our own hooks are named *lighthouse*
LiveOS/config/hooks/*/*
!LiveOS/config/hooks/*/*lighthouse*

# Generated at build time from VERSION
LiveOS/config/includes.chroot/etc/lighthouse-release
LiveOS/.lock
LiveOS/binary.modified_timestamps
LiveOS/*.zsync
